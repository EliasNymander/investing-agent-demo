# =============================================================
# Investing Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Phase 1: Mock Mode ---
# Set to true to use mock data (no API calls needed)
USE_CLAUDE_MOCK=true

# --- Claude / Anthropic (required for Phase 2 AI analysis) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Alpha Vantage (required for Phase 2: stocks/ETFs) ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# --- CoinGecko (optional for Phase 2: crypto prices) ---
# Free tier available — attribution required (see README)
COINGECKO_API_KEY=your_coingecko_api_key_here

# --- NewsAPI (required for Phase 2: news headlines) ---
NEWS_API_KEY=your_newsapi_key_here

# --- Server ---
PORT=3001
NODE_ENV=development
